@model List<Notificacao>
@{
    ViewData["Title"] = "Notificações";
}
<div class="estreito">
    <h1>Notificações</h1>
    @if (Model.Count == 0)
    {
        <div class="vazio">
            <h2>Nada por aqui ainda</h2>
            <p>Avisamos aqui cada etapa dos seus pedidos e quando um produto que você esperava chegar.</p>
        </div>
    }
    else
    {
        <ul class="notificacoes">
            @foreach (var n in Model)
            {
                <li class="@(n.Lida ? "" : "nova")">
                    <div>
                        <strong>@n.Titulo</strong>
                        @if (!n.Lida) { <span class="selo ok">Nova</span> }
                        <p>@n.Mensagem</p>
                        <small class="muted">@n.DataRegistro.ToString("dd/MM/yyyy 'às' HH:mm")</small>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Link) && Url.IsLocalUrl(n.Link))
                    {
                        <a class="botao secundario pequeno" href="@n.Link">Ver</a>
                    }
                </li>
            }
        </ul>
    }
</div>
