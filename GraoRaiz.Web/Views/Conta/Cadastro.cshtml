@model CadastroViewModel
@{
    ViewData["Title"] = "Criar conta";
}
<div class="estreito" style="max-width:480px">
    <h1>Criar conta</h1>
    <form class="painel" asp-action="Cadastro" method="post">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        @if (Model.Erro is not null)
        {
            <p class="aviso erro" role="alert" style="margin:0 0 16px">@Model.Erro</p>
        }
        <div class="campo">
            <label for="Nome">Nome completo</label>
            <input id="Nome" name="Nome" type="text" value="@Model.Nome" autocomplete="name" required />
        </div>
        <div class="campo">
            <label for="NomeSocial">Nome social (opcional)</label>
            <input id="NomeSocial" name="NomeSocial" type="text" value="@Model.NomeSocial" aria-describedby="dica-social" />
            <span id="dica-social" class="dica">Se preenchido, é este o nome que aparece no site, no aplicativo e nos pedidos.</span>
        </div>
        <div class="campo">
            <label for="Email">E-mail</label>
            <input id="Email" name="Email" type="email" value="@Model.Email" autocomplete="email" required />
        </div>
        <div class="campo">
            <label for="Senha">Senha</label>
            <input id="Senha" name="Senha" type="password" autocomplete="new-password" minlength="6" required aria-describedby="dica-senha" />
            <span id="dica-senha" class="dica">Pelo menos 6 caracteres.</span>
        </div>
        <button class="botao largo" type="submit">Criar conta</button>
        <p style="margin:16px 0 0">Já tem conta? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Entrar</a></p>
    </form>
</div>
