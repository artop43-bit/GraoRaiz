@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos";
    var filtro = ViewBag.Status as string;
}
<div class="container">
    <h1>Pedidos</h1>
    <partial name="_Menu" />
    <nav class="filtros" aria-label="Filtrar por status">
        <a class="filtro" asp-action="Pedidos" aria-current="@(filtro is null ? "true" : null)">Todos</a>
        @foreach (var s in StatusPedido.Todos)
        {
            <a class="filtro" asp-action="Pedidos" asp-route-status="@s" aria-current="@(filtro == s ? "true" : null)">@StatusPedido.Descricao(s)</a>
        }
    </nav>
    @if (Model.Count == 0)
    {
        <p class="vazio">Nenhum pedido com este status.</p>
    }
    else
    {
        <div class="rolagem">
            <table class="tabela">
                <thead><tr><th>Pedido</th><th>Data</th><th>Cliente</th><th>Itens</th><th>Status</th><th class="num">Total</th><th>Próxima etapa</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var proximo = StatusPedido.Proximo(p.Status);
                        <tr>
                            <td><a asp-action="Pedido" asp-route-id="@p.Id"><strong>#@p.Id</strong></a></td>
                            <td>@p.DataPedido.ToString("dd/MM HH:mm")</td>
                            <td>@p.NomeCliente</td>
                            <td>@p.QuantidadeItens</td>
                            <td><partial name="_Status" model="p.Status" /></td>
                            <td class="num">@p.ValorTotal.ToString("C")</td>
                            <td>
                                @if (proximo is not null)
                                {
                                    <form asp-action="AvancarStatus" asp-route-id="@p.Id" method="post">
                                        <button class="botao pequeno" type="submit">@StatusPedido.Descricao(proximo)</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="muted">Concluído</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
