@model Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
    var proximo = StatusPedido.Proximo(Model.Status);
}
<div class="container">
    <h1>Pedido #@Model.Id <partial name="_Status" model="Model.Status" /></h1>
    <partial name="_Menu" />
    <div class="duas-colunas">
        <section class="painel">
            <p><strong>@Model.NomeCliente</strong> · @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")<br />
                <span class="muted">@Model.EnderecoResumo</span></p>
            <div class="rolagem">
                <table class="tabela">
                    <thead><tr><th>Produto</th><th>Moagem</th><th class="num">Qtd.</th><th class="num">Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Itens)
                        {
                            <tr><td>@i.NomeProduto</td><td>@i.MoagemDescricao</td><td class="num">@i.Quantidade</td><td class="num">@i.Subtotal.ToString("C")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.PrevisaoEntrega is not null) { <p class="muted">Previsão de entrega: @Model.PrevisaoEntrega.Value.ToString("dd/MM/yyyy")@(Model.IdAssinatura is null ? "" : $" · assinatura #{Model.IdAssinatura}")</p> }
            <div class="resumo" style="position:static;margin-top:16px">
                <div class="linha"><span>Produtos</span><span>@Model.Subtotal.ToString("C")</span></div>
                @if (Model.ValorDesconto > 0)
                {
                    <div class="linha desconto"><span>Descontos@(Model.CodigoCupom is null ? "" : $" · cupom {Model.CodigoCupom}")@(Model.PontosUsados > 0 ? $" · {Model.PontosUsados} Grãos" : "")@(Model.IdAssinatura is null ? "" : " · assinatura")</span><span>− @Model.ValorDesconto.ToString("C")</span></div>
                }
                <div class="linha"><span>Frete</span><span>@Model.ValorFrete.ToString("C")</span></div>
                <div class="linha total"><span>Total</span><span>@Model.ValorTotal.ToString("C")</span></div>
            </div>
        </section>
        <aside class="painel">
            <h2>Andamento</h2>
            <partial name="_LinhaTempo" model="Model" />
            @if (proximo is not null)
            {
                <form asp-action="AvancarStatus" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="voltarPara" value="detalhe" />
                    <button class="botao largo" type="submit">Marcar como: @StatusPedido.Descricao(proximo)</button>
                </form>
            }
            <form asp-action="DefinirStatus" asp-route-id="@Model.Id" method="post" style="margin-top:16px">
                <div class="campo">
                    <label for="status">Definir outro status</label>
                    <select id="status" name="status">
                        @foreach (var s in StatusPedido.Todos)
                        {
                            <option value="@s" selected="@(s == Model.Status)">@StatusPedido.Descricao(s)</option>
                        }
                    </select>
                </div>
                <button class="botao secundario largo" type="submit">Aplicar status</button>
            </form>
            @if (Model.Status is not (StatusPedido.Cancelado or StatusPedido.Entregue))
            {
                <form asp-action="DefinirStatus" asp-route-id="@Model.Id" method="post" style="margin-top:12px"
                      data-confirmar="Cancelar o pedido #@Model.Id? Os itens voltam para o estoque e os Grãos são estornados.">
                    <input type="hidden" name="status" value="@StatusPedido.Cancelado" />
                    <button class="botao secundario perigo largo" type="submit">Cancelar pedido e devolver ao estoque</button>
                </form>
            }
        </aside>
    </div>
</div>
