@model List<Pedido>
@{
    ViewData["Title"] = "Meus pedidos";
}
<div class="container">
    <h1>Meus pedidos</h1>
    @if (Model.Count == 0)
    {
        <div class="vazio">
            <h2>Você ainda não fez pedidos</h2>
            <p>Quando comprar, o andamento de cada pedido aparece aqui e no aplicativo.</p>
            <a class="botao" asp-controller="Catalogo" asp-action="Index">Ver os cafés</a>
        </div>
    }
    else
    {
        <div class="rolagem">
            <table class="tabela">
                <thead><tr><th>Pedido</th><th>Data</th><th>Itens</th><th>Previsão</th><th>Status</th><th class="num">Total</th><th><span class="pular">Ações</span></th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><strong>#@p.Id</strong></td>
                            <td>@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@p.QuantidadeItens</td>
                            <td>@(p.Status is StatusPedido.Entregue or StatusPedido.Cancelado || p.PrevisaoEntrega is null ? "—" : "até " + p.PrevisaoEntrega.Value.ToString("dd/MM"))</td>
                            <td><partial name="_Status" model="p.Status" />@if (p.IdAssinatura is not null) { <span class="selo ok" style="margin-left:6px">Assinatura</span> }</td>
                            <td class="num">@p.ValorTotal.ToString("C")</td>
                            <td><a class="botao secundario pequeno" asp-action="Detalhe" asp-route-id="@p.Id">Acompanhar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
